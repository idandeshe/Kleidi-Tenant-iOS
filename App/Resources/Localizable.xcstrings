    "wire.doneBody": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε. Ο διαχειριστής θα ελέγξει το έμβασμα και θα το επιβεβαιώσει — θα δείτε «Το έμβασμα επιβεβαιώθηκε από τον ιδιοκτήτη» στον μήνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you. Your property manager will check the transfer and confirm it — you will see \"Wire confirmed by property owner\" on the month."
          }
        }
      }
    },
    "wire.doneTitle": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το έμβασμα δηλώθηκε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wire declared"
          }
        }
      }
    },
    "wire.intro": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώστε τον διαχειριστή ποιο ενοίκιο πληρώσατε και επισυνάψτε το αποδεικτικό της τράπεζας. Θα το ελέγξει και θα το επιβεβαιώσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell your property manager which rent you paid and attach the bank confirmation. They will check it and confirm."
          }
        }
      }
    },
    "wire.monthsHint": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε έναν ή περισσότερους μήνες που καλύπτει αυτό το έμβασμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one or more months covered by this transfer."
          }
        }
      }
    },
    "wire.monthsLabel": {
      "extractionState": "manual",
